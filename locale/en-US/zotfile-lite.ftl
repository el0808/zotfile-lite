### Preferences pane
zotfile-pref-renaming = Renaming Rules
zotfile-pref-renaming-desc = The filename is built from the item's metadata. Use %a for the author, %y for the year and %t for the title. Text in curly brackets is included only when all wildcards inside resolve.
zotfile-pref-format = Filename format
zotfile-pref-truncate-title = Shorten long titles (cut at . : ? !)
zotfile-pref-truncate-smart = Cut long titles at a word boundary
zotfile-pref-truncate-authors = Limit the number of authors
zotfile-pref-add-etal = Append "et al" when authors are truncated

zotfile-pref-remove-periods = Remove periods
zotfile-pref-replace-blanks = Replace blanks with underscores
zotfile-pref-lower-case = Convert to lower case
zotfile-pref-remove-diacritics = Remove diacritics
zotfile-pref-use-zotero-rename = Use Zotero's own filename scheme (ignore the format above)

zotfile-pref-location = Attachment Location
zotfile-pref-dest-dir = Destination folder for linked files
zotfile-pref-choose-folder = Choose...
zotfile-pref-import = Store copies in the Zotero library (imported attachment)
zotfile-pref-subfolder = Create subfolders
zotfile-pref-subfolder-desc = Subfolder rule, e.g. /%w/%y for publisher/year. Applies to linked attachments only.

zotfile-pref-source = Source Folder
zotfile-pref-source-dir = Source folder
zotfile-pref-source-desc = "Attach New File" takes the most recently modified file from this folder.
zotfile-pref-all-files = Attach all files in the source folder (not just the newest)
zotfile-pref-use-filetypes = Only these file types

zotfile-pref-autorename = Automatic Renaming
zotfile-pref-autorename-never = Never rename automatically
zotfile-pref-autorename-ask = Always ask
zotfile-pref-autorename-ask-multi = Ask when the item already has other attachments
zotfile-pref-autorename-always = Always rename

zotfile-pref-messages = Result Window
zotfile-pref-notify-duration = Close the result window after (ms; click it to close immediately)
