### 首选项面板
zotfile-pref-renaming = 重命名规则
zotfile-pref-renaming-desc = 文件名由条目元数据生成。%a 表示作者,%y 表示年份,%t 表示标题。花括号内的内容仅在其中所有通配符都非空时才会包含。
zotfile-pref-format = 文件名格式
zotfile-pref-truncate-title = 截断过长标题(在 . : ? ! 处截断)
zotfile-pref-truncate-smart = 在单词边界处截断标题
zotfile-pref-truncate-authors = 限制作者数量
zotfile-pref-add-etal = 作者被截断时追加 et al

zotfile-pref-remove-periods = 移除句点
zotfile-pref-replace-blanks = 空格替换为下划线
zotfile-pref-lower-case = 转换为小写
zotfile-pref-remove-diacritics = 移除变音符号
zotfile-pref-use-zotero-rename = 使用 Zotero 自带的命名方案(忽略上面的格式)

zotfile-pref-location = 附件位置
zotfile-pref-dest-dir = 链接附件的目标文件夹
zotfile-pref-choose-folder = 选择...
zotfile-pref-import = 在 Zotero 库中存储副本(导入附件)
zotfile-pref-subfolder = 创建子文件夹
zotfile-pref-subfolder-desc = 子文件夹规则,例如 /%w/%y 表示 出版社/年份。仅对链接附件生效。

zotfile-pref-source = 源文件夹
zotfile-pref-source-dir = 源文件夹
zotfile-pref-source-desc = "附加新文件"会从这个文件夹中取最近修改的文件。
zotfile-pref-all-files = 附加源文件夹中的所有文件(而非仅最新文件)
zotfile-pref-use-filetypes = 仅限这些文件类型

zotfile-pref-autorename = 自动重命名
zotfile-pref-autorename-never = 从不自动重命名
zotfile-pref-autorename-ask = 总是询问
zotfile-pref-autorename-ask-multi = 当条目已有其他附件时询问
zotfile-pref-autorename-always = 总是重命名

zotfile-pref-messages = 提示窗口
zotfile-pref-notify-duration = 结果窗口自动关闭时间(毫秒,点击窗口立即关闭)
